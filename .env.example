# Server
PORT=3000

# Meta / WhatsApp Cloud API
WHATSAPP_TOKEN=your_permanent_system_user_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=choose_any_random_string
WHATSAPP_APP_SECRET=your_meta_app_secret

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash

# Bot behavior
# Minutes the bot stays active after a customer's first message in a conversation.
BOT_RESPONSE_WINDOW_MINUTES=10
# Hours of silence after which the next customer message counts as a new conversation.
BOT_SESSION_GAP_HOURS=6

# Courses lookup (scraped from the institute's own course listing page)
COURSES_URL=https://idhs.org.ar/cursos-inscripcion/
# Hours the scraped course list is cached in memory before re-fetching.
COURSES_CACHE_TTL_HOURS=12

# Postgres (Neon free tier). Copy the pooled connection string from the Neon dashboard.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Agent inbox at /inbox — HTTP Basic Auth credentials for the employee.
INBOX_USER=idhs
INBOX_PASSWORD=choose_a_strong_password
