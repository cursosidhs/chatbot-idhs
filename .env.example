# Server
PORT=3000

# Meta / WhatsApp Cloud API
WHATSAPP_TOKEN=your_permanent_system_user_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=choose_any_random_string
WHATSAPP_APP_SECRET=your_meta_app_secret
# Meta expires each Graph API version ~2 years after release and calls to an
# expired one fail. Check developers.facebook.com/docs/graph-api/changelog/versions
# before it lapses. v23.0 expires 2027-10-08.
GRAPH_API_VERSION=v23.0

# Embedded Signup test harness at /es-test. Leave both empty and the page
# stays inert; the rest of the bot doesn't need them.
META_APP_ID=
META_ES_CONFIG_ID=

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash

# Bot behavior
# Minutes the bot stays active after a customer's first message in a conversation.
# 300 = 5 hours. Past this the bot sends the "we'll get back to you" notice once
# instead of replying.
BOT_RESPONSE_WINDOW_MINUTES=300
# Hours of silence after which the next customer message counts as a new conversation.
BOT_SESSION_GAP_HOURS=6

# Courses lookup (scraped from the institute's own course listing page)
COURSES_URL=https://idhs.org.ar/cursos-inscripcion/
# Hours the scraped course list is cached in memory before re-fetching.
COURSES_CACHE_TTL_HOURS=12

# Postgres (Neon free tier). Copy the pooled connection string from the Neon dashboard.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Agent inbox at /inbox. One "nombre:contraseña" per employee, comma-separated.
# The name is shown as the author of their replies, so use how the team knows
# them ("maria", "juan"). Give each person their own password.
INBOX_USERS=maria:una_clave_larga,juan:otra_clave_larga
# Single-user form, still supported if INBOX_USERS is not set:
# INBOX_USER=idhs
# INBOX_PASSWORD=choose_a_strong_password
# Seconds between auto-refreshes of the inbox. 0 disables it.
INBOX_REFRESH_SECONDS=30
# Largest incoming photo/PDF stored, in MB. Files live in Postgres and Neon's
# free tier caps at 0.5 GB, so this keeps one big file from eating a chunk.
MEDIA_MAX_MB=10
